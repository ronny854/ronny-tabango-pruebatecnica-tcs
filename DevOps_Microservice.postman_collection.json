{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "DevOps Microservice Tests",
		"description": "Collection to test the DevOps microservice endpoint",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Valid POST Request - Success",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has correct message format\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include(\"Hello Juan Perez your message will be send\");",
							"});",
							"",
							"pm.test(\"JWT token is present in response headers\", function () {",
							"    pm.response.to.have.header(\"X-JWT-KWY\");",
							"    var jwt = pm.response.headers.get(\"X-JWT-KWY\");",
							"    console.log(\"Generated JWT: \" + jwt);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Parse-REST-API-Key",
						"value": "2f5ae96c-b558-4c7b-a590-a501ae1c3f6c",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"message\": \"This is a test\",\n    \"to\": \"Juan Perez\",\n    \"from\": \"Rita Asturia\",\n    \"timeToLifeSec\": 45\n}"
				},
				"url": {
					"raw": "http://localhost:5000/DevOps",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"DevOps"
					]
				},
				"description": "Valid POST request with correct API Key and payload"
			},
			"response": []
		},
